# Copy this file to .env and fill in the values.

# Signs login tokens. Required - the app refuses to start without it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me

# The LLM, from https://console.groq.com. Only the chat needs it; the rest of the app runs
# without it.
GROQ_API_KEY=replace-me

# Shared with the website (the same value goes in frontend/.env.local). It lets the
# backend trust the visitor address the website passes on, so rate limits stay per
# visitor. Generate it the same way as SECRET_KEY.
FRONTEND_SECRET=replace-me

# Websites allowed to call the API from a browser, as a JSON list. Only needed if a browser
# calls the backend directly; the website itself goes through its own server.
# CORS_ORIGINS=["http://localhost:3000"]
