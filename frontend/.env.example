# Copy to .env.local and fill in.

# The FastAPI backend. Only this website's server uses it - browsers never call it
# directly, so it doesn't need to be public.
API_URL=http://127.0.0.1:8000

# The same value as FRONTEND_SECRET in backend/.env. It lets the backend trust the visitor
# address this server passes on, so rate limits stay per visitor.
FRONTEND_SECRET=replace-me
