# Copy to .env.local and adjust. Both point at the FastAPI backend.

# Used by the server when rendering pages (never sent to the browser).
API_URL=http://127.0.0.1:8000

# Used by the chat in the browser. Built into the page, so set it before `npm run build`.
# The backend must list this site's address in its CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:8000
